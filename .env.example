# ═══════════════════════════════════════════════════
# DARAJA — Variables d'environnement
# ═══════════════════════════════════════════════════
# Copiez ce fichier vers .env (local) ou configurez
# ces variables dans Vercel > Project > Settings > Environment Variables
# ═══════════════════════════════════════════════════

# ── BASE DE DONNÉES (OBLIGATOIRE) ──
# En production (Vercel) : utiliser une base PostgreSQL externe
# Options recommandées :
#   1. Vercel Postgres : postgres://... (vercel postgres)
#   2. Supabase : postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres
#   3. Neon : postgresql://user:pass@ep-xxx.neon.tech/dbname
#   4. Railway : postgresql://...
DATABASE_URL="postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres"

# En développement local (SQLite) :
# DATABASE_URL="file:./db/custom.db"

# ── URL PUBLIQUE DE L'APPLICATION ──
# Pour les liens de partage de documents
NEXT_PUBLIC_APP_URL="https://votre-app.vercel.app"

# ── CODE SECRET PROPRIÉTAIRE ──
# Code d'accès à la console super-admin (Ctrl+Shift+Alt+D)
ADMIN_SECRET_CODE="847825"

# ── PAIEMENTS (SANDBOX) ──
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
FEDAPAY_API_KEY=""

# ── WHATSAPP BUSINESS API ──
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ── STOCKAGE OBJET (production) ──
# En production, utiliser un stockage externe :
#   - Vercel Blob : BLOB_READ_WRITE_TOKEN
#   - AWS S3 / Hostinger Object Storage
BLOB_READ_WRITE_TOKEN=""
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# ── EMAIL (notifications) ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

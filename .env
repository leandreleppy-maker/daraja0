# DARAJA — Fichier .env (placeholder pour build Vercel)
# Ce fichier est COMMIT sur GitHub et fournit une URL placeholder
# pour que `prisma generate` fonctionne pendant le build.
#
# ⚠️ En production, Vercel utilise les variables d'environnement
# configurées dans Settings > Environment Variables, qui OVERRIDE
# ces valeurs placeholder.

# URL placeholder pour le build (Vercel remplace par la vraie URL)
DATABASE_URL="postgresql://placeholder:placeholder@db.placeholder.supabase.co:5432/postgres"

# URL publique (Vercel remplace par la vraie URL)
NEXT_PUBLIC_APP_URL="https://daraja.vercel.app"

# Code secret propriétaire
ADMIN_SECRET_CODE="847825"
